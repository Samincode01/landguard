# LandGuard BD — Environment Variables Example
# Duplicate this file to .env and provide your secret keys.

# SQLite / Database connection
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Server-side ONLY, never expose as NEXT_PUBLIC_)
# Obtain from Google AI Studio (https://aistudio.google.com/)
# Optional: if left unset or empty, the application safely runs with the built-in curated FAQ engine.
GEMINI_API_KEY=""

# Optional Model Override (Defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"
